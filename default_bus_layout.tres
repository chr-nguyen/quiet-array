[gd_resource type="AudioBusLayout" load_steps=3 format=3]

[sub_resource type="AudioEffectLowPassFilter" id="OutdoorFilter"]
cutoff_hz = 6500.0

[sub_resource type="AudioEffectReverb" id="ShopReverb"]
room_size = 0.35
damping = 0.65
wet = 0.12
dry = 1.0

[resource]
bus/0/name = &"Master"
bus/0/volume_db = -4.0
bus/1/name = &"Music"
bus/1/send = &"Master"
bus/1/volume_db = -3.0
bus/2/name = &"Effects"
bus/2/send = &"Master"
bus/2/volume_db = -3.0
bus/3/name = &"Outdoors"
bus/3/send = &"Effects"
bus/3/effect/0/effect = SubResource("OutdoorFilter")
bus/3/effect/0/enabled = true
bus/4/name = &"Interior"
bus/4/send = &"Effects"
bus/4/effect/0/effect = SubResource("ShopReverb")
bus/4/effect/0/enabled = true
