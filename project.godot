; Quiet Array / Last Light — Godot 4, desktop OpenGL compatibility.
config_version=5

[application]
config/name="Last Light — Quiet Array"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="A lonely roadside gas station. A small first-person night scene."

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
environment/defaults/default_clear_color=Color(0.022, 0.025, 0.037, 1)

[audio]
default_bus_layout="res://default_bus_layout.tres"
